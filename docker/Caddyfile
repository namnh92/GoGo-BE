# Automatic HTTPS (Let's Encrypt) + reverse proxy. DOMAIN/ACME_EMAIL from env.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Security headers (TLS everywhere is handled by Caddy itself).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:3000
}
