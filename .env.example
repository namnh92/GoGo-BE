# GoGo-BE environment template. Copy to .env.local. NEVER put real secrets here.
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# PostgreSQL + PostGIS
DATABASE_URL=postgres://gogo:gogo@localhost:5433/gogo

# Redis (cache, rate limit, BullMQ)
REDIS_URL=redis://localhost:6380

# Auth — generate per environment, store in secret manager in prod.
# openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_GUEST_SESSION_TTL_SECONDS=604800

# Web session cookie
COOKIE_SECRET=
COOKIE_SECURE=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Feature flags
FLAG_AI_REFINEMENT=false
FLAG_PLACE_IMPORT_AUTOPUBLISH=false

# Providers (server-side only; leave empty to use fake adapters)
GOOGLE_MAPS_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SENTRY_DSN=

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
