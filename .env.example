# GoGo-BE environment template. Copy to .env (dev) / .env.prod (VPS).
# NEVER put real secrets here. Real keys are handed over privately and land
# only in .env.prod on the server / CI secrets — see docs/infrastructure.md §5.
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# Which proxies may set X-Forwarded-For (that header decides req.ip, which
# every IP rate limit keys on). `1` = trust only the immediate hop (Caddy);
# `false` = direct exposure, trust nobody; or a CIDR list for multi-hop
# ingress. Never `true` — that lets any caller spoof its own IP.
# Which proxies may set X-Forwarded-For. `false` when the API is reachable
# directly (the dev default): trusting a hop that is really the client lets it
# spoof its address and get a fresh rate-limit bucket per request. Behind
# Cloudflare set the hop count or the CIDR list. Production must set it.
TRUST_PROXY=false

# PostgreSQL + PostGIS (prod compose: postgres://gogo:<pw>@postgres:5432/gogo)
DATABASE_URL=postgres://gogo:gogo@localhost:5433/gogo
# Pool size PER PROCESS. Ceiling is max_connections split across api replicas,
# worker, migrations and any psql — not the app's concurrency (#21).
DB_POOL_MAX=10

# Redis (cache, rate limit, BullMQ) (prod compose: redis://redis:6379)
REDIS_URL=redis://localhost:6380

# Auth — generate per environment, store in secret manager in prod.
# openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_GUEST_SESSION_TTL_SECONDS=604800
# SEC-003 — phiên CMS hết hạn sớm hơn app consumer (security rule).
# 8 tiếng đủ một ca làm; refresh của consumer sống 30 ngày.
AUTH_ADMIN_REFRESH_TTL_SECONDS=28800

# Web session cookie
COOKIE_SECRET=
# SSE room stream (#154). Off falls clients back to polling; it never breaks them.
REALTIME_SSE_ENABLED=true
# Encrypts admin TOTP secrets at rest (#62). Required >=32 chars in production:
# a database dump already carries the password hashes, so the second factor is
# what should still stop an attacker. Derived from AUTH_JWT_SECRET when empty
# outside production, so dev and test boot without one.
# AI feedback parsing (#48). Off until a provider DPA and prompt/data privacy
# review are done; the deterministic keyword parser handles feedback meanwhile.
FLAG_AI_FEEDBACK=false
CMS_MFA_ENCRYPTION_KEY=
COOKIE_SECURE=false

# CORS — allowlist các origin của browser client, phân tách bằng dấu phẩy.
# Bắt buộc phải liệt kê tường minh: session dùng cookie, nên `*` hoặc để
# nguyên `true` là giao session cho bất kỳ trang nào. Rỗng = chặn toàn bộ
# cross-origin (mặc định an toàn, nhưng CMS sẽ không gọi được API).
#   dev:  Web http://localhost:5173 · CMS http://localhost:5174
#   prod: https://app.gogo.id.vn,https://cms.gogo.id.vn
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Feature flags
FLAG_AI_REFINEMENT=false
FLAG_PLACE_IMPORT_AUTOPUBLISH=false
# ADR-0007 — bật Routes API. Mặc định tắt: chưa tốn tiền, hành vi y như cũ.
FLAG_ROUTES_API=false
# #334 — đọc provenance Google từ cả `place_provider_sources` lẫn `place_sources`.
# Mặc định bật: tắt là trạng thái mà place đến từ ingestion không có attribution.
# Chỉ tắt để rollback phần reader của PR1 trong một release; migration là
# forward-only nên không revert theo.
PROVENANCE_UNIFIED_READS=true

# ──────────────────────────────────────────────────────────────────────────
# WAITING SLOTS — điền khi key được bàn giao private. Để trống = fake/skip.
# ──────────────────────────────────────────────────────────────────────────

# Ba key Google, mỗi API một key, không key nào đỡ cho key nào. Mỗi key
# restrict đúng API của nó trong console — nên fallback vốn không chạy được:
# key phạm vi Places đem gọi Sheets thì Google trả 403 API_KEY_SERVICE_BLOCKED.
# Tách key cũng là thứ cô lập quota và giới hạn thiệt hại khi lộ.

# [CHỜ KEY] Google Places API (New). Restrict theo server IP.
# Trống = FakePlaceProvider + FakeAreaAutocomplete (boot ghi warn).
GOOGLE_PLACES_API_KEY=

# [CHỜ KEY] Google Routes API — thời gian di chuyển thật (ADR-0007).
# Chỉ được dùng khi FLAG_ROUTES_API=true; tắt flag thì mọi chặng dùng ước
# lượng đường chim bay, và đó là câu trả lời thật chứ không phải hàng thay thế.
GOOGLE_ROUTES_API_KEY=

# [CHỜ KEY] Google Sheets API v4 — đọc sheet nguồn cho CMS bulk import.
# Trống = FakeSheets, và mọi import trả 503 SHEET_PROVIDER_NOT_CONFIGURED.
GOOGLE_SHEETS_API_KEY=

# [CHỜ KEY] Cloudflare R2 — media + backup offsite (S3 API token).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Object storage for user media (#171). Empty here: POST /v1/uploads then
# answers 503 UPLOAD_NOT_CONFIGURED instead of handing out a dead URL.
R2_BUCKET=

# [CHỜ KEY] Base URL công khai cho ảnh địa điểm (#151). Trống thì API **bỏ hẳn**
# ảnh khỏi response thay vì trả URL không load được — client hiện placeholder
# trung tính, còn hơn một ảnh vỡ.
MEDIA_PUBLIC_BASE_URL=
R2_BACKUP_BUCKET=

# [CHỜ KEY] Sentry — error monitoring (project DSN).
SENTRY_DSN=

# Privacy-request ledger (#255 / ADR-0011). SLA theo từng loại yêu cầu — JSON:
#   {"delete":{"ackHours":72,"fulfillHours":720},"export":{...},"correction":{...}}
# Rỗng = dùng mặc định PROVISIONAL trong shared/privacy-ledger.ts. Legal phải
# xác nhận giá trị production theo Luật 91/2025/QH15 + NĐ 356/2025/NĐ-CP
# trước khi khoá. Không có một con số 72h toàn cục cho mọi loại.
PRIVACY_SLA_JSON=
# Giữ request-level record bao lâu sau khi đóng rồi hard-delete. Product
# default 12 tháng — cần Legal sign-off trước production.
PRIVACY_RETENTION_MONTHS=12

# CMS single sign-on (#62 / ADR-0010). Cloudflare Access xác thực người vận
# hành với IdP phía trên, ép MFA ở đó, rồi ký một assertion mà Worker của
# GoGo-CMS chuyển tiếp xuống đây. BE verify chữ ký chứ không tin header: API
# này gọi thẳng được từ internet, nên `Cf-Access-Jwt-Assertion` là header ai
# đặt cũng được.
#
# Rỗng = SSO tắt cho môi trường này, `POST /v1/cms/auth/access-exchange` trả
# 503 nói đúng lý do; password + TOTP không bị ảnh hưởng. Đặt một biến mà bỏ
# biến kia thì **boot fail**: team domain không kèm audience tag sẽ nhận
# assertion phát cho bất kỳ ứng dụng nào khác trong cùng tài khoản.
# Production (APP_ENV=prod) bắt buộc phải có cả hai.
#
# Giá trị lấy từ GoGo-Infra: team domain là `<team>.cloudflareaccess.com`,
# audience tag là id của Access application (terraform output
# `access_application_id`), không phải hostname.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Push: BE không nói chuyện thẳng với APNs/FCM. Đường đi là
# BE -> OneSignal REST -> APNs/FCM (GoGo-OneSignal-Implementation-Spec.md), nên
# .p8 và FCM V1 nằm trong OneSignal app chứ không phải ở đây. Biến
# ONESIGNAL_* vào file này cùng lúc với code đọc chúng (NTF-BE-002, #193);
# giá trị đã sẵn trong SSM: GoGo-Infra/config/secrets.manifest.yml.

# Uptime/heartbeat (healthchecks.io hoặc Better Stack heartbeats) — URL ping
# sau mỗi run thành công; monitor báo động khi ping ngừng.
HEARTBEAT_URL_OUTBOX=
HEARTBEAT_URL_INGEST=
HEARTBEAT_URL_PRIVACY=
HEARTBEAT_URL_BACKUP=

# Observability
# Bearer token for GET /v1/metrics (#120). Empty = the route answers 404:
# series names and label values describe internal structure, so an
# unconfigured deployment must not publish them.
METRICS_TOKEN=
# ADR-0007 §E1 — where the collector writes, e.g.
# `http://192.168.68.168:9090/api/v1/write`. Present is what makes GoGo-Infra
# add the Alloy overlay at all, so the container and the endpoint arrive
# together or neither does.
#
# §E7: the read path follows this by default, so setting it moves the whole
# store in one action. Do not set it while the API is meant to keep reading
# Grafana Cloud — that is the split-brain the ADR forbids.
PROMETHEUS_REMOTE_WRITE_URL=

# Read path overrides. Normally all empty: the API queries whatever
# PROMETHEUS_REMOTE_WRITE_URL names, unauthenticated, which is what a
# Prometheus restricted to one source address on a LAN expects.
#
# Set METRICS_QUERY_URL only where read and write endpoints genuinely differ (a
# read replica, a proxy). Credentials are optional and move together — half a
# credential is a 401 that looks like an outage.
METRICS_QUERY_URL=
METRICS_QUERY_USERNAME=
METRICS_QUERY_TOKEN=

# How much history the store actually holds. Empty falls back to
# GRAFANA_RETENTION_DAYS, whose 14-day default is Grafana Cloud Free's. Set it
# after cutover: the self-hosted store keeps a different number, and a console
# offering 30 days over a 15-day store reports a window nobody can answer.
METRICS_RETENTION_DAYS=
# Port the worker serves its own /metrics on (#318). Bulk import runs in the
# worker, so its registry holds series the API scrape has never seen. Never
# published to the host — a collector on the same compose network reaches it,
# nothing else does. Same METRICS_TOKEN guards it.
WORKER_METRICS_PORT=9101
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Chi phí nhà cung cấp (#335, ADR-0012) ─────────────────────────────────
# Sổ dùng bền: mọi call Google ghi vào `provider_usage_daily`. Tắt (false) là
# đường lùi của PR2 — không ghi gì, `/cms/ops/costs` trả về
# `sourcesConfigured: false` đúng như trước.
COST_LEDGER_ENABLED=true
# Cửa sổ mất mát khi bị SIGKILL, tính bằng ms. Dừng có thứ tự thì không mất gì;
# flush lỗi thì số đếm nằm lại trong buffer và lần sau ghi tiếp.
COST_LEDGER_FLUSH_MS=5000
# COST-BE-016 (#368) — worker job that re-prices this month's and last month's
# usage meters into provider_cost_daily (basis=ESTIMATED). Idempotent; the
# interval only bounds staleness of the estimate. `false` stops the job.
COST_ESTIMATE_ENABLED=true
COST_ESTIMATE_POLL_MS=900000
# COST-BE-017 (#369) — collector scheduler tick (freshness rows, paid-collector
# guardrails, cost-of-cost row). `false` stops it. Budget overrides epic §20's
# default ($1/month DEV, $5/month PROD) in USD micros.
COST_COLLECTORS_ENABLED=true
COST_COLLECTOR_POLL_MS=300000
# COST_MONITORING_BUDGET_MICROS=1000000
# COST-BE-024 (#383) — Cloudflare R2 + Workers usage collector (GraphQL
# Analytics, đọc-only, miễn phí). SSM `cloudflare/analytics-token` +
# `cloudflare/account-id` (INF-060 #114). Thiếu một trong hai ⇒ collector không
# đăng ký, không lỗi; provider hiện freshness UNKNOWN. Account id có thể lấy từ
# R2_ACCOUNT_ID (cùng account). Hai biến danh sách (phẩy) giới hạn số liệu về
# tài nguyên của môi trường này; trống = cả account.
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_R2_BUCKETS=gogo-dev-assets,gogo-dev-public
# CLOUDFLARE_WORKER_SCRIPTS=gogo-dev-share-link

# COST-BE-025 (#384) — Upstash Redis usage collector (Developer API
# `GET /v2/redis/stats/{id}`, đọc-only, miễn phí). SSM `upstash/api-email`,
# `upstash/api-key`, `upstash/database-id` (INF-060 #114). Thiếu bất kỳ giá trị
# nào ⇒ collector không đăng ký, không lỗi; provider hiện freshness UNKNOWN.
# Database id lấy ở console (không phải tên hay endpoint); REDIS_URL không
# thay thế được — đó là credential data-plane, scope khác.
UPSTASH_API_EMAIL=
UPSTASH_API_KEY=
UPSTASH_DATABASE_ID=

# COST-BE-026 (#385) — Neon Postgres usage collector (API `GET
# /consumption_history/projects` trên gói Launch trở lên; `GET /projects/{id}`
# trên mọi gói, kể cả Free — đọc-only, miễn phí, không đánh thức compute). SSM
# `neon/api-key` (INF-008 #8) + `neon/project-id` (INF-060 #114). Thiếu một
# trong hai ⇒ collector không đăng ký, không lỗi; provider hiện freshness
# UNKNOWN. Project id lấy ở console (Settings → General), không phải tên;
# DATABASE_URL không thay thế được — đó là credential data-plane.
NEON_API_KEY=
NEON_PROJECT_ID=

# COST-BE-027 (#386) — AWS Cost Explorer collector (ACTUAL cost).
#
# **Collector duy nhất TỐN TIỀN: $0.01/request.** Vì vậy nó dùng key RIÊNG,
# không bao giờ fallback về AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY chung —
# thừa hưởng identity sẵn có sẽ khiến cả khoản chi lẫn phạm vi quyền thành
# ngẫu nhiên. IAM chỉ cần `ce:GetCostAndUsage`. SSM
# `aws/cost-explorer-access-key-id` + `aws/cost-explorer-secret-access-key`
# (INF-060 #114). Thiếu một trong hai ⇒ collector không đăng ký, không tốn
# tiền, provider hiện freshness UNKNOWN. Scheduler ép `maxCallsPerDay=1` dựa
# trên bảng `cost_source_freshness` nên trần sống sót qua restart.
AWS_COST_EXPLORER_ACCESS_KEY_ID=
AWS_COST_EXPLORER_SECRET_ACCESS_KEY=
# AWS_COST_EXPLORER_SESSION_TOKEN=
# AWS_COST_EXPLORER_REGION=us-east-1

# COST-BE-027 (#386) — GitHub Actions usage + cost (đọc-only, miễn phí).
#
# Endpoint mà issue nêu (`/settings/billing/actions`) đã bị GitHub tắt
# 2025-09-26; nguồn hiện tại là enhanced billing platform
# `GET /users|organizations/{account}/settings/billing/usage`. Token chỉ cần
# quyền đọc billing. SSM `github/billing-token` + `github/billing-account`
# (INF-060 #114). Account là login chủ sở hữu repo (GoGo là tài khoản
# **user** `namnh92`, không phải org); thiếu ⇒ collector không đăng ký.
GITHUB_BILLING_TOKEN=
GITHUB_BILLING_ACCOUNT=
# GITHUB_BILLING_ACCOUNT_KIND=user

# Ngân sách cứng cho scope `google.places.refresh` (người dùng đầu tiên là job
# refresh của PR7, #340).
#
# **Không đặt = từ chối**, không phải "không giới hạn": biến môi trường thiếu là
# cách thực tế nhất để cái chốt này biến mất trên production, và một cái chốt
# mặc định mở thì không phải chốt. Ba trần cùng được kiểm tra trong một
# transaction Postgres — số call, số đơn vị theo operation, và chi phí xấu nhất
# theo **giá niêm yết, không trừ hạn mức miễn phí**.
#
# Quota theo ngày của Google trên Places API (New) là lưới an toàn bên ngoài
# (INF-015) và nên đặt cao hơn một chút; Cloud Billing budget chỉ là cảnh báo.
# PLACE_REFRESH_DAILY_MAX_CALLS=2000
# PLACE_REFRESH_DAILY_MAX_LIST_COST_USD=5
# PLACE_REFRESH_DAILY_MAX_UNITS_GOOGLE_DETAILS_LIVENESS=2000
# PLACE_REFRESH_DAILY_MAX_UNITS_GOOGLE_DETAILS_CORE=200
# PLACE_REFRESH_DAILY_MAX_UNITS_GOOGLE_DETAILS_QUALITY=50

# ── Prod compose only (docker/docker-compose.prod.yml) ────────────────────
# DOMAIN=api.gogo.example
# ACME_EMAIL=ops@example.com
# POSTGRES_PASSWORD=<openssl rand -base64 24>

# Worker poll intervals in milliseconds. Default 5000.
#
# These dominate the Redis command cost of an idle worker: a scheduler firing
# every 5s creates and completes a job every 5s whether or not there is work.
# DEV runs on Upstash, which bills per command, so DEV sets these higher —
# 30000 costs a third of the commands and delays dispatch by up to 30 seconds.
# Production uses Redis with an SLA and keeps the default.
OUTBOX_POLL_MS=5000
INGEST_POLL_MS=5000
