{
  "name": "gogo-be",
  "version": "0.1.0",
  "private": true,
  "description": "GoGo backend — API BFF, database, search, suggestion, workers, CMS APIs",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @gogo/api dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx libs/database/src/migrate.ts",
    "db:seed": "tsx libs/database/src/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
